# Секретный токен: Discord Developer Portal → приложение → Bot → Reset Token.
# Никому не отправляйте токен. Файл .env исключён из Git.
DISCORD_TOKEN=

# ID вашего Discord-сервера (не имя и не ссылка-приглашение).
DISCORD_GUILD_ID=

# ID отдельной категории «Голосовые комнаты».
# ВСЕ обычные голосовые каналы этой категории считаются временными.
DISCORD_CATEGORY_ID=
