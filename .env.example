# Секретный токен: Discord Developer Portal → приложение → Bot → Reset Token.
# Никому не отправляйте токен. Файл .env исключён из Git.
DISCORD_TOKEN=

# ID вашего Discord-сервера (не имя и не ссылка-приглашение).
DISCORD_GUILD_ID=

# ID выделенной категории голосовых комнат.
# ВСЕ обычные голосовые каналы этой категории считаются временными.
DISCORD_CATEGORY_ID=

# Включайте после включения Server Members Intent в Discord Developer Portal.
# false сохраняет прежний режим: только голосовые комнаты.
COMMUNITY_ENABLED=false

# База и резервные копии хранятся в data/, вне Git.
# На Botkeep используйте Merge files; Replace files может удалить data/.
COMMUNITY_DATABASE_PATH=data/lazybot.sqlite
